# ==========================================
# RankGit - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e configure com seus dados reais:
#   cp .env.example .env
# ==========================================

# 1. Banco de Dados PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rankgit
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=sua_senha_do_postgres_aqui

# 2. Segurança JWT (chave segura HMAC-SHA256 com no mínimo 256 bits)
JWT_SECRET=coloque_aqui_uma_chave_secreta_longa_e_aleatoria_com_mais_de_32_caracteres_123456
JWT_EXPIRATION_MS=86400000

# 3. GitHub OAuth App (Para login social com GitHub)
# Obtenha em: https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=seu_client_id_do_github
GITHUB_CLIENT_SECRET=seu_client_secret_do_github

# 4. Token Pessoal da API do GitHub (Opcional - aumenta o limite de 60 para 5.000 requisições/hora)
# Obtenha em: https://github.com/settings/tokens (classic token com escopo público)
GITHUB_API_TOKEN=seu_github_personal_access_token_aqui

# 5. Configuração da Aplicação
INITIAL_ADMIN_USERNAME=seu_usuario_github_admin
OAUTH2_REDIRECT_URI=http://localhost:4200/oauth2/redirect
